{
  "name": "dispriv-ts",
  "version": "1.0.0",
  "description": "Typescript dispriv implementation.",
  "main": "bin/index.js",
  "scripts": {
    "build": "rimraf ./bin && tsc",
    "start": "npm run build && node bin/index.js",
    "dev": "ts-node Source/index",
    "dev:watch": "nodemon -x ts-node Source/index",
    "check": "tsc --noEmit",
    "lint": "prettier --check ./Source && eslint ./Source --ext .ts",
    "format": "prettier --write ./Source && eslint ./Source --ext .ts --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/McMistrzYT/Dispriv-TS.git"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.0",
    "@types/dotenv": "^8.2.0",
    "@types/express": "^4.17.17",
    "@types/murmurhash3js": "^3.0.3",
    "@types/node": "^18.16.3",
    "@types/uuid": "^9.0.2",
    "@types/ws": "^8.5.4",
    "@typescript-eslint/eslint-plugin": "^5.59.2",
    "@typescript-eslint/parser": "^5.59.2",
    "eslint": "^8.39.0",
    "eslint-plugin-rules": "file:Rules"
  },
  "nodemonConfig": {
    "ext": "*.ts,*.json,*.env",
    "ignore": [
      "bin/**"
    ]
  },
  "keywords": [
    "dispriv",
    "discord",
    "private server"
  ],
  "author": "ISTHG Team",
  "contributors": [
    "Back <back@stumblepriv.xyz>",
    "mc <mc@stumblepriv.xyz>",
    "notpies",
    "nullptr"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/McMistrzYT/Dispriv-TS/issues"
  },
  "homepage": "https://github.com/McMistrzYT/Dispriv-TS#readme",
  "dependencies": {
    "bcrypt": "^5.1.0",
    "class-transformer": "^0.5.1",
    "colorette": "^2.0.20",
    "discord-protos": "^1.0.4",
    "dotenv": "^16.3.1",
    "erlpack": "^0.1.4",
    "eslint-config-prettier": "^8.8.0",
    "express": "^4.18.2",
    "fast-zlib": "^2.0.1",
    "murmurhash3js": "^3.0.1",
    "node-webrtc": "^0.0.0",
    "nodemon": "^2.0.22",
    "prettier": "^2.8.8",
    "reflect-metadata": "^0.1.13",
    "rimraf": "^5.0.1",
    "sharp": "^0.32.1",
    "socketio": "^1.0.0",
    "sqlite3": "^5.1.6",
    "ts-node": "^10.9.1",
    "typeorm": "^0.3.16",
    "uuid": "^9.0.0",
    "wrtc": "^0.4.7",
    "ws": "^8.13.0"
  }
}
