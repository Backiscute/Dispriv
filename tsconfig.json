{
    "compilerOptions": {
        "outDir": "bin",
        "sourceMap": false,
        "target": "ESNext",
        "declaration": false,
        "module": "NodeNext",
        "moduleResolution": "nodenext",
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "resolveJsonModule": true,
        "noErrorTruncation": true
    },
    "include": ["Source/**/*.ts"],
    "exclude": ["node_modules"]
}
